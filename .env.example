# ══════════════════════════════════════════════════════════════
# Material Data Management System — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file to backend/.env and fill in actual values.
# NEVER commit the .env file to version control.

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Supabase PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Supabase Storage ─────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=material-data

# ── Application ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
PORT=3001

APP_TIMEZONE=Asia/Kolkata
RETENTION_DAYS=5
APP_STORAGE_WARNING_GB=0.8

# ── Upload Limits ────────────────────────────────────────────
MAX_FILE_SIZE_MB=25
SIGNED_URL_EXPIRY_SECONDS=900
